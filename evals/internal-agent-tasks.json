    {
      "id": "repair-development-single",
      "source_task_id": "repair-development",
      "agent_mode": "single",
      "goal": "pricing.py 的 discounted_price 把折扣率当作实际售价比例。只把错误的 return 表达式改为 price * (1 - discount)，保留其他字符和文件。运行 python check.py 确认。",
      "timeout_s": 600,
      "tool_whitelist": [
        "read_file",
        "list_dir",
        "write_file",
        "bash"
      ],
      "fixture_files": {
        "pricing.py": "def discounted_price(price, discount):\n    # discount is a fraction between 0 and 1.\n    return price * discount\n",
        "check.py": "from pricing import discounted_price\nassert discounted_price(100, 0.2) == 80\nassert discounted_price(50, 0) == 50\nassert discounted_price(50, 1) == 0\nprint('checks passed')\n"
      },
      "grader": {
        "kind": "files_equal",
        "files": {
          "pricing.py": "def discounted_price(price, discount):\n    # discount is a fraction between 0 and 1.\n    return price * (1 - discount)\n",
          "check.py": "from pricing import discounted_price\nassert discounted_price(100, 0.2) == 80\nassert discounted_price(50, 0) == 50\nassert discounted_price(50, 1) == 0\nprint('checks passed')\n"
        }
      },
      "metadata": {
        "split": "development",
        "category": "code_repair",
        "protected_paths": [
          "check.py"
        ]
      }
    },
