    {
      "id": "aggregate-holdout-single",
      "source_task_id": "aggregate-holdout",
      "agent_mode": "single",
      "goal": "读取 logs.jsonl，每行一条记录。按 service 统计 status 为 error 的条数，重复 id 只统计第一次出现的记录（即使之后状态不同）。把对象写到 result.json，所有出现过的 service 都要保留，缺少 error 时为 0。不要修改输入文件。",
      "timeout_s": 600,
      "tool_whitelist": [
        "read_file",
        "list_dir",
        "write_file",
        "bash"
      ],
      "fixture_files": {
        "logs.jsonl": "{\"id\":\"a\",\"service\":\"api\",\"status\":\"error\"}\n{\"id\":\"b\",\"service\":\"web\",\"status\":\"ok\"}\n{\"id\":\"a\",\"service\":\"api\",\"status\":\"ok\"}\n{\"id\":\"c\",\"service\":\"api\",\"status\":\"error\"}\n{\"id\":\"d\",\"service\":\"web\",\"status\":\"error\"}\n{\"id\":\"e\",\"service\":\"worker\",\"status\":\"ok\"}\n{\"id\":\"b\",\"service\":\"web\",\"status\":\"error\"}\n"
      },
      "grader": {
        "kind": "json_equals",
        "path": "result.json",
        "expected": {
          "api": 2,
          "web": 1,
          "worker": 0
        }
      },
      "metadata": {
        "split": "holdout",
        "category": "data_processing",
        "protected_paths": [
          "logs.jsonl"
        ]
      }
    },
