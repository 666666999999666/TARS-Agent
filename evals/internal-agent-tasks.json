        "check.py": "from bounds import in_closed_interval\nassert in_closed_interval(3, 1, 3)\nassert in_closed_interval(1, 1, 3)\nassert not in_closed_interval(4, 1, 3)\nprint('checks passed')\n"
      },
      "grader": {
        "kind": "files_equal",
