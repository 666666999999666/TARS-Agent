{
  "schema_version": "1.0",
  "suite_id": "internal-agent-tasks-v1",
  "name": "TARS single versus orchestrated tasks",
  "description": "Eight fixed tasks in four categories; four development and four held-out cases, paired modes, three repetitions. Freeze after development; do not tune on held-out cases.",
  "adapter": "internal",
  "execution_mode": "agent_tasks",
  "model_config_ref": {
    "source": "runtime_config",
    "reference": "frozen-candidate-runtime-config"
  },
  "default_repetitions": 3,
  "sandbox_mode": "required",
  "tasks": [
    {
      "id": "extract-development-single",
      "source_task_id": "extract-development",
      "agent_mode": "single",
      "goal": "读取 warehouse.json，筛选 active 为 true 且 stock 小于 5 的商品，按 sku 升序把 sku 列表写到 result.json。不要修改输入文件。",
      "timeout_s": 600,
      "tool_whitelist": [
        "read_file",
        "list_dir",
        "write_file",
        "bash"
      ],
      "fixture_files": {
        "warehouse.json": "[\n  {\n    \"sku\": \"C3\",\n    \"active\": true,\n    \"stock\": 0\n  },\n  {\n    \"sku\": \"A1\",\n    \"active\": true,\n    \"stock\": 4\n  },\n  {\n    \"sku\": \"B2\",\n    \"active\": false,\n    \"stock\": 1\n  },\n  {\n    \"sku\": \"D4\",\n    \"active\": true,\n    \"stock\": 5\n  }\n]\n"
      },
      "grader": {
        "kind": "json_equals",
        "path": "result.json",
        "expected": [
          "A1",
          "C3"
        ]
      },
      "metadata": {
        "split": "development",
        "category": "document_extraction",
        "protected_paths": [
          "warehouse.json"
        ]
      }
    },
