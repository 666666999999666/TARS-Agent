# TARS-Agent 项目环境示例；复制为 .env 后可调整普通选项。
# 项目 .env 只解析允许字段，不修改 PATH、代理、SDK 端点或进程环境。
TARS_HOST=127.0.0.1
TARS_PORT=7437
TARS_LOG_LEVEL=INFO
TARS_LOG_FORMAT=text
TARS_LLM_DEFAULT_MODEL=claude-sonnet-4-6
TARS_LLM_MAX_TOKENS=8192
TARS_MAX_STEPS=20
TARS_COMPACT_THRESHOLD=0.80

# 官方服务可从项目 .env 读取 ANTHROPIC_API_KEY，但不要提交真实值。
# ANTHROPIC_API_KEY=

# 以下字段仅在启动 daemon 的真实进程环境或受信 HOME/config.toml 中设置。
# 写进本文件不会授权这些字段；默认 HOME 为 ~/.tars-baseline。
# TARS_HOME=C:/Users/your-name/.tars-baseline
# TARS_LLM_API_KEY=                 # 自定义端点专用 key
# TARS_LLM_BASE_URL=https://your-provider.example
# TARS_SANDBOX_MODE=required       # preferred 仍需每次宿主回退审批
# TARS_SANDBOX_IMAGE=tars-agent-sandbox:0.8.0
# TARS_DOCKER_BINARY=docker
# TARS_LOG_FILE=                   # 空值仅写 stderr
# TARS_TRACE_ENABLED=false
# TARS_TRACE_INCLUDE_LLM_PAYLOAD=false
# TARS_TRACE_FILE=C:/trusted-path/daemon.jsonl
# TARS_LLM_TOTAL_TIMEOUT_S=120
# TARS_LLM_CONNECT_TIMEOUT_S=10
# TARS_LLM_READ_TIMEOUT_S=60
# TARS_LLM_WRITE_TIMEOUT_S=10
# TARS_LLM_POOL_TIMEOUT_S=10
# TARS_LLM_ATTEMPTS=2
# TARS_LLM_RETRY_DELAY_S=1
# TARS_LLM_REQUEST_LIMIT=100       # 正整数；unlimited 表示不限次数但继续累计

# 请求限额默认 100；仅受信 HOME/config.toml 的 [llm] request_limit 或真实进程环境可改。
# TOML 示例：request_limit = "unlimited"；项目 .env 中的限额设置不会生效。
# 账本在受信 HOME/acceptance/request-budget.sqlite3；不限次数时仍原子累计，绝不清零。
# 重试、压缩和子代理共享同一账本；重启或切换工作区不会清除历史请求计数。
